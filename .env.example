# ---- Core ----
# Public URL of the app (used in emails and share links). On Vercel set to your production domain.
APP_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs access tokens.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Database (Neon on Vercel sets these automatically) ----
DATABASE_URL=postgres://instantlive:instantlive@localhost:5432/instantlive
# Optional direct (non-pooled) URL used for migrations.
# DATABASE_URL_UNPOOLED=

# ---- Email (Resend). If unset, emails are printed to the server log. ----
# RESEND_API_KEY=
# EMAIL_FROM="InstantLive <no-reply@yourdomain.com>"

# ---- Rate limiting (Upstash Redis on Vercel sets these). If unset, an in-memory limiter is used. ----
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Streaming (LiveKit Cloud) - used from module 5 ----
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
